// @strict-types
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Регистрация ссылочного типа.
// 
// Параметры:
//  ОписаниеЗапроса - Структура - Описание запроса:
//	 * ИмяТаблицы - Строка - Имя таблицы
//	 * Текст - Строка - Текст запроса
//	 * Параметры - Структура - Параметры запроса
//	Продюсер - СправочникСсылка.кфкПродюсеры - Продюсер
//	ПолучитьОбъект - Булево - Получить объект ссылочного типа
Процедура ВыполнитьРегистрациюСсылочногоТипа(ОписаниеЗапроса, Продюсер, ПолучитьОбъект) Экспорт
	
	Счетчик = 0;
	МаксРазмерПорции = кфкОбработкаСобытийСлужебный.МаксРазмерПорцииРегистрации();
	ПараметрыРегистрации = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Продюсер, Истина);
	СобытиеРегистрации = Перечисления.кфкСобытияРегистрации.Принудительно;
	
	Выборка = ВыборкаДанныхСсылочногоТипа(ОписаниеЗапроса);
	
	ПараметрыПрогресса = НачалоПрогресса(Выборка.Количество());
	ОбработатьИтерациюПрогресса(ПараметрыПрогресса, 0); // старт
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		
		ОбъектРегистрации = ?(ПолучитьОбъект, Выборка.Ссылка.ПолучитьОбъект(), Выборка.Ссылка);
		кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
			ОбъектРегистрации, СобытиеРегистрации, "", Ложь, ПараметрыРегистрации);
		
		Если Счетчик >= МаксРазмерПорции Тогда // порционная запись
			кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации, Истина);
			ОбработатьИтерациюПрогресса(ПараметрыПрогресса, Счетчик);
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации);
	КонецЕсли;
	ЗавершитьПрогресс(ПараметрыПрогресса, Счетчик, ОписаниеЗапроса.ИмяТаблицы);
	
КонецПроцедуры

// Выполнить регистрацию независимого регистра
// 
// Параметры:
//  ОписаниеЗапроса - Структура - Описание запроса:
//	 * ИмяТаблицы - Строка - Имя таблицы
//	 * Текст - Строка - Текст запроса
//	 * Параметры - Структура - Параметры запроса
//	Продюсер - СправочникСсылка.кфкПродюсеры - Продюсер
Процедура ВыполнитьРегистрациюНезависимогоРегистра(ОписаниеЗапроса, Продюсер) Экспорт
	
	Счетчик = 0;
	МаксРазмерПорции = кфкОбработкаСобытийСлужебный.МаксРазмерПорцииРегистрации();
	ПараметрыРегистрации = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Продюсер, Истина);
	СобытиеРегистрации = Перечисления.кфкСобытияРегистрации.Принудительно;
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОписаниеЗапроса.ИмяТаблицы);
	НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
	Выборка = ВыборкаДанныхРегистра(ОписаниеЗапроса);
	
	ПараметрыПрогресса = НачалоПрогресса(Выборка.Количество());
	ОбработатьИтерациюПрогресса(ПараметрыПрогресса, 0); // старт
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		
		Если Счетчик >= МаксРазмерПорции Тогда // порционная запись
			кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
				НаборЗаписей, СобытиеРегистрации, "", Ложь, ПараметрыРегистрации);
			кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации, Истина);
			ОбработатьИтерациюПрогресса(ПараметрыПрогресса, Счетчик);
			НаборЗаписей.Очистить();
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
			НаборЗаписей, СобытиеРегистрации, "", Ложь, ПараметрыРегистрации);
		кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации);
	КонецЕсли;
	ЗавершитьПрогресс(ПараметрыПрогресса, Счетчик, ОписаниеЗапроса.ИмяТаблицы);
	
КонецПроцедуры

// Выполнить регистрацию подчиненного регистра
// 
// Параметры:
//  ОписаниеЗапроса - Структура - Описание запроса:
//	 * ИмяТаблицы - Строка - Имя таблицы
//	 * Текст - Строка - Текст запроса
//	 * Параметры - Структура - Параметры запроса
//	Продюсер - СправочникСсылка.кфкПродюсеры - Продюсер
Процедура ВыполнитьРегистрациюПодчиненногоРегистра(ОписаниеЗапроса, Продюсер) Экспорт
	
	Счетчик = 0;
	МаксРазмерПорции = кфкОбработкаСобытийСлужебный.МаксРазмерПорцииРегистрации();
	ПараметрыРегистрации = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Продюсер, Истина);
	СобытиеРегистрации = Перечисления.кфкСобытияРегистрации.Принудительно;
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОписаниеЗапроса.ИмяТаблицы);
	НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
	Выборка = ВыборкаДанныхРегистра(ОписаниеЗапроса);
	
	ПараметрыПрогресса = НачалоПрогресса(Выборка.Количество());
	ОбработатьИтерациюПрогресса(ПараметрыПрогресса, 0); // старт
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		
		//@skip-check property-return-type
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		
		Если Счетчик >= МаксРазмерПорции Тогда // порционная запись
			кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
				НаборЗаписей, СобытиеРегистрации, "", Ложь, ПараметрыРегистрации);
			кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации, Истина);
			ОбработатьИтерациюПрогресса(ПараметрыПрогресса, Счетчик);
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
			НаборЗаписей, СобытиеРегистрации, "", Ложь, ПараметрыРегистрации);
		кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(ПараметрыРегистрации);
	КонецЕсли;
	ЗавершитьПрогресс(ПараметрыПрогресса, Счетчик, ОписаниеЗапроса.ИмяТаблицы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выборка данных ссылочного типа.
// 
// Параметры:
//  ОписаниеЗапроса - Структура - Описание запроса:
//	 * Текст - Строка - Текст запроса
//	 * Параметры - Структура - Параметры запроса 
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка данных ссылочного типа:
//	 * Ссылка - ЛюбаяСсылка - Ссылка на объект регистрации
Функция ВыборкаДанныхСсылочногоТипа(ОписаниеЗапроса)
	
	Запрос = СформироватьЗапрос(ОписаниеЗапроса);
	
	Возврат Запрос.Выполнить().Выбрать(); // TODO: ВыбратьПоСсылкам - возвращает объекты, но на практике прироста нет
	
КонецФункции

// Выборка данных регистра.
// 
// Параметры:
//  ОписаниеЗапроса - Структура - Описание запроса:
//	 * Текст - Строка - Текст запроса
//	 * Параметры - Структура - Параметры запроса
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка данных регистра
Функция ВыборкаДанныхРегистра(ОписаниеЗапроса)
	
	Запрос = СформироватьЗапрос(ОписаниеЗапроса);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция СформироватьЗапрос(ОписаниеЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ОписаниеЗапроса.Текст;
	Для Каждого Параметр Из ОписаниеЗапроса.Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Возврат Запрос;
	
КонецФункции

// Начало прогресса.
// 
// Параметры:
//  Количество - Число - Количество
// 
// Возвращаемое значение:
// 	Структура - Начало прогресса:
//	 * Начало - Дата - Начало
//	 * Процент - Число - Процент
//	 * Количество - Число - Количество
//	 * Обработано - Число - Обработано
//	 * ПиковаяСкорость - Число - Пиковая скорость
Функция НачалоПрогресса(Количество)
	
	Результат = Новый Структура;
	Результат.Вставить("Начало", ТекущаяУниверсальнаяДата());
	Результат.Вставить("Процент", -1);
	Результат.Вставить("Количество", Количество);
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("ПиковаяСкорость", 0);
	
	Возврат Результат;
	
КонецФункции

// Обработать итерацию прогресса.
// 
// Параметры:
//  Параметры - Структура - Параметры:
//	 * Начало - Дата - Начало
//	 * Процент - Число - Процент
//	 * Количество - Число - Количество
//	 * Обработано - Число - Обработано
//	 * ПиковаяСкорость - Число - Пиковая скорость
//  Количество - Число - Количество
Процедура ОбработатьИтерациюПрогресса(Параметры, Количество = 1)
	
	Параметры.Обработано = Параметры.Обработано + Количество;
	
	МаксимальныйПроцент = 100;
	РазрядностьПроцента = 2;
	Процент = ?(Параметры.Количество > 0,
		Окр(Параметры.Обработано / Параметры.Количество * МаксимальныйПроцент, РазрядностьПроцента), 0);
	
	Если Параметры.Процент < Процент Тогда
		
		Прошло = ТекущаяУниверсальнаяДата() - Параметры.Начало; // Число
		РазрядностьСкорости = 2;
		СредняяСкорость = ?(Прошло > 0, Окр(Параметры.Обработано / Прошло, РазрядностьСкорости), 0);
		ОставшеесяВремя = ?(СредняяСкорость > 0,
			Окр((Параметры.Количество - Параметры.Обработано) / СредняяСкорость, 0), 0); // Число 
		
		Параметры.Процент = Процент;
		Параметры.ПиковаяСкорость = Макс(Параметры.ПиковаяСкорость, СредняяСкорость);
		
		// Зарегистрировано
		Шаблон = НСтр("ru = 'Зарегистрировано: %1 из %2'");
		ТекстСообщения = СтрШаблон(Шаблон, Параметры.Обработано, Параметры.Количество);
		// Скорость
		Если Параметры.ПиковаяСкорость > 0 Тогда
			Шаблон = НСтр("ru = 'Скорость: %1 записей/сек (пиковая: %2)'");
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтрШаблон(Шаблон, СредняяСкорость, Параметры.ПиковаяСкорость);
		КонецЕсли;
		// Время
		Если Прошло > 0 Или ОставшеесяВремя > 0 Тогда
			Шаблон = НСтр("ru = 'Время: прошло %1,
				|       осталось ~ %2'");
			ТекстСообщения = ТекстСообщения + Символы.ПС
				+ СтрШаблон(Шаблон, ПредставлениеВремени(Прошло), ПредставлениеВремени(ОставшеесяВремя));
		КонецЕсли;
		
		ДлительныеОперации.СообщитьПрогресс(Параметры.Процент, ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

// Завершить прогресс.
// 
// Параметры:
//	Параметры - Структура - Параметры:
//	 * Начало - Дата - Начало
//	 * Процент - Число - Процент
//	 * Количество - Число - Количество
//	 * Обработано - Число - Обработано
//	 * ПиковаяСкорость - Число - Пиковая скорость
//	Количество - Число - Количество
//	ИмяТаблицы - Строка - Имя таблицы
Процедура ЗавершитьПрогресс(Параметры, Количество, ИмяТаблицы)
	
	ОбработатьИтерациюПрогресса(Параметры, Количество);
	
	Если Параметры.Обработано > кфкОбработкаСобытийСлужебный.МаксРазмерПорцииРегистрации() Тогда // Макс+1
		
		Прошло = ТекущаяУниверсальнаяДата() - Параметры.Начало; // Число
		РазрядностьСкорости = 2;
		СредняяСкорость = ?(Прошло > 0, Окр(Параметры.Обработано / Прошло, РазрядностьСкорости), 0);
		
		// BSLLS:Typo-off
		ШаблонСообщения = НСтр("ru = '%1 - зарег. %2 за %3 (%4 сообщ/с, пик: %5)'");
		// BSLLS:Typo-on
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ИмяТаблицы,
			Параметры.Обработано, ПредставлениеВремени(Прошло, Истина, Ложь),
			СредняяСкорость, Параметры.ПиковаяСкорость);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текстовое представление интервала времени, заданного в секундах.
//
// Параметры:
//
//  Время - Число - интервал времени в секундах.
//
//  ПолноеПредставление	- Булево - кратное или полное представление времени.
//		Например, интервал 1 000 000 секунд:
//		1) полное представление:  11 дней 13 часов 46 минут 40 секунд;
//		2) краткое представление: 11 дней 13 часов.
//  ПолнаяФорма - Булево - Булево - полная или сокращенная форма представления времени
//  ВыводитьСекунды - Булево - Ложь, если секунды не требуются.
//  
// Возвращаемое значение:
//   Строка - представление интервала времени.
//
Функция ПредставлениеВремени(Знач Время, ПолноеПредставление = Истина, ПолнаяФорма = Истина, ВыводитьСекунды = Истина)

	Если Время = 0 Тогда
		Возврат НСтр("ru = '<1 сек'");
	КонецЕсли;

	Если Время < 0 Тогда
		Время = -Время;
	КонецЕсли;

	Представления = ПредставленияЕдиницВремени(ПолнаяФорма);
	Количество = КоличествоЕдиницВремени(Время, ВыводитьСекунды);

	Возврат ПредставлениеСоставногоИнтервала(
		Количество, Представления, ПолноеПредставление, ВыводитьСекунды);

КонецФункции

Функция ПредставленияЕдиницВремени(ПолнаяФорма)

	Результат = Новый Структура;
	Если ПолнаяФорма Тогда
		Результат.Вставить("Недели", НСтр("ru = ';%1 неделя;;%1 недели;%1 недель;%1 недели'"));
		Результат.Вставить("Дни", НСтр("ru = ';%1 день;;%1 дня;%1 дней;%1 дня'"));
		Результат.Вставить("Часы", НСтр("ru = ';%1 час;;%1 часа;%1 часов;%1 часа'"));
		Результат.Вставить("Минуты", НСтр("ru = ';%1 минута;;%1 минуты;%1 минут;%1 минуты'"));
		Результат.Вставить("Секунды", НСтр("ru = ';%1 секунда;;%1 секунды;%1 секунд;%1 секунды'"));
	Иначе
		Результат.Вставить("Недели", НСтр("ru = ';%1 нед.;;%1 нед.;%1 нед.;%1 нед.'"));
		Результат.Вставить("Дни", НСтр("ru = ';%1 д.;;%1 д.;%1 д.;%1 д.'"));
		Результат.Вставить("Часы", НСтр("ru = ';%1 ч.;;%1 ч.;%1 ч.;%1 ч.'"));
		Результат.Вставить("Минуты", НСтр("ru = ';%1 мин.;;%1 мин.;%1 мин.;%1 мин.'"));
		Результат.Вставить("Секунды", НСтр("ru = ';%1 сек.;;%1 сек.;%1 сек.;%1 сек.'"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция КоличествоЕдиницВремени(Время, ВыводитьСекунды)

	СекундВМинуте = 60;
	МинутВЧасе = 60;
	ЧасовВСутках = 24;
	ДнейВНеделе = 7;

	КоличествоНедель = Цел(Время / СекундВМинуте / МинутВЧасе / ЧасовВСутках / ДнейВНеделе);
	КоличествоДней = Цел(Время / СекундВМинуте / МинутВЧасе / ЧасовВСутках);
	КоличествоЧасов = Цел(Время / СекундВМинуте / МинутВЧасе);
	КоличествоМинут = Цел(Время / СекундВМинуте);
	КоличествоСекунд = Цел(Время);

	КоличествоСекунд = КоличествоСекунд - КоличествоМинут * СекундВМинуте;
	КоличествоМинут = КоличествоМинут - КоличествоЧасов * МинутВЧасе;
	КоличествоЧасов = КоличествоЧасов - КоличествоДней * ЧасовВСутках;
	КоличествоДней = КоличествоДней - КоличествоНедель * ДнейВНеделе;

	Если Не ВыводитьСекунды Тогда
		КоличествоСекунд = 0;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Недели", КоличествоНедель);
	Результат.Вставить("Дни", КоличествоДней);
	Результат.Вставить("Часы", КоличествоЧасов);
	Результат.Вставить("Минуты", КоличествоМинут);
	Результат.Вставить("Секунды", КоличествоСекунд);
	Результат.Вставить("ИсходноеВремя", Время);

	Возврат Результат;

КонецФункции

Функция ПредставлениеСоставногоИнтервала(Количество, Представления, ПолноеПредставление, ВыводитьСекунды)

	ОстатокМеньшеНедели = Количество.Дни + Количество.Часы + Количество.Минуты + Количество.Секунды;
	Если Количество.Недели > 0 И ОстатокМеньшеНедели = 0 Тогда
		Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			Представления.Недели, Количество.Недели);
	КонецЕсли;

	ДнейВНеделе = 7;
	Количество.Дни = Количество.Дни + Количество.Недели * ДнейВНеделе;
	Результат = "";
	Счетчик = 0;

	Если Количество.Дни > 0 Тогда
		Результат = Результат
			+ СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(Представления.Дни, Количество.Дни) + " ";
		Счетчик = Счетчик + 1;
	КонецЕсли;

	Если Количество.Часы > 0 Тогда
		Результат = Результат
			+ СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(Представления.Часы, Количество.Часы) + " ";
		Счетчик = Счетчик + 1;
	КонецЕсли;

	Если НужноВывестиМинуты(Количество, ПолноеПредставление, ВыводитьСекунды, Счетчик) Тогда
		Результат = Результат
			+ СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
				Представления.Минуты, Количество.Минуты) + " ";
		Счетчик = Счетчик + 1;
	КонецЕсли;

	Если НужноВывестиСекунды(Количество, ПолноеПредставление, ВыводитьСекунды, Счетчик) Тогда
		Результат = Результат
			+ СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
				Представления.Секунды, Количество.Секунды);
	КонецЕсли;

	Возврат СокрП(Результат);

КонецФункции

Функция НужноВывестиМинуты(Количество, ПолноеПредставление, ВыводитьСекунды, Счетчик)

	КоличествоЕдиницКраткогоПредставления = 2;
	Возврат (ПолноеПредставление Или Счетчик < КоличествоЕдиницКраткогоПредставления)
		И Количество.Минуты > 0
		Или Количество.ИсходноеВремя = 0 И Не ВыводитьСекунды;

КонецФункции

Функция НужноВывестиСекунды(Количество, ПолноеПредставление, ВыводитьСекунды, Счетчик)

	КоличествоЕдиницКраткогоПредставления = 2;
	НетБолееКрупныхЕдиниц = Количество.Недели + Количество.Дни + Количество.Часы + Количество.Минуты = 0;
	Возврат ВыводитьСекунды
		И (ПолноеПредставление Или Счетчик < КоличествоЕдиницКраткогоПредставления)
		И (Количество.Секунды > 0 Или НетБолееКрупныхЕдиниц);

КонецФункции

#КонецОбласти

#КонецЕсли
