Функция ЗначениеСоответствуетПростомуТипуФормата(Значение, ТипФормата)
	Возврат (ТипЗнч(Значение) = Тип("Строка") И СтрНайти(ТипФормата.Имя, "string") > 0)
		Или (ТипЗнч(Значение) = Тип("Число") И СтрНайти(ТипФормата.Имя, "decimal") > 0)
		Или (ТипЗнч(Значение) = Тип("Булево") И СтрНайти(ТипФормата.Имя, "boolean") > 0)
		Или (ТипЗнч(Значение) = Тип("Дата") И СтрНайти(ТипФормата.Имя, "date") > 0);
КонецФункции

