#Область СлужебныйПрограммныйИнтерфейс

#Область ИнициализацияОбмена

// Инициализирует компоненты обмена.
//
// Параметры:
//	НаправлениеОбмена - Строка - направление выполнения обмена: "Отправка" | "Получение".
//
// Возвращаемое значение:
//	Структура - содержит компоненты обмена (правила обмена и параметры обмена):
//	 * НаправлениеОбмена - Строка - "Отправка" или "Получение".
//	 
//	 * ВерсияФорматаОбмена - Строка - номер версии формата обмена.
//	 * XMLСхема - Строка - пространство имен формата обмена.
//	 * ЭтоEnterpriseData - Булево - признак того, что обмен выполняется с EnterpriseData.
//	 * БазовыеСхемыФормата - Соответствие Из КлючИЗначение - содержит соответствие пространств имена базовых схем формата
//	
//	 * МенеджерОбмена - Неопределено, ОбщийМодуль - модуль с правилами конвертации.
//	 * ЭтоМенеджерОбменКФК - Булево - модуль с правилами конвертации является частью КФК
//	 * ВерсияФорматаМенеджераОбмена - Строка - номер версии формата модуля с правилами конвертации.
//	 
//	 * КлючСообщения - Строка - ключ сообщения Kafka.
//	 * СвойстваСообщения - Структура - Дополнительные свойства сообщения.
//	 * ЗаголовкиСообщения - Соответствие Из КлючИЗначение - Заголовки сообщения Kafka.
//	 
//	 * ФлагОшибки - Булево - признак наличия ошибки при выполнении действия обмена.
//	 * ФлагПропустить - Булево - признак пропуска выполнения действия обмена.
//	 * ПротоколКонвертации - Массив Из Строка - список сообщений обмена данными.
//	 * НавигационнаяСсылка - Булево - (Получение) добавление навигационной ссылки в протокол конвертации.
//	 
//	 * ОтключитьПреобразованиеВNull - Булево - (Отправка) 'Истина' cохранять пустые значения без преобразования в null. По умолчанию Ложь (преобразование в null)
//	 * ИспользоватьТранзакции - Булево - (Получение) признак использования транзакций при записи полученных данных.
//	 * ОбменДаннымиЗагрузка - Булево - (Получение) значение устанавливаемого свойства "ОбменДанными.Загрузка".
//	 * ОтключитьМеханизмРегистрации - Булево - (Получение) признак необходимости регистрации данных к обратной отправке.
//	 
//	 * ОбъектыВыборкиФормата - Структура - (Получение) объекты выборки формата, которые отстувуют в схеме:
//	 	** Ключ - Строка - Имя ПОД
//	 	** Значение - Строка - Имя объекта выборки формата, которые отстувуют в схеме:
//	 * ОбъектыФормата - Структура - объекты формата:
//	 	** Ключ - Строка - Имя ПКО
//	 	** Значение - Строка - Имя объекта формата
//
Функция ИнициализироватьКомпонентыОбмена(НаправлениеОбмена) Экспорт
	
	КомпонентыОбмена = Новый Структура;
	КомпонентыОбмена.Вставить("НаправлениеОбмена", НаправлениеОбмена);
	
	// схема обмена
	КомпонентыОбмена.Вставить("ВерсияФорматаОбмена", ""); // см. ВерсияФорматаОбмена.ШаблоныТекстовМодулей
	КомпонентыОбмена.Вставить("XMLСхема", "");
	КомпонентыОбмена.Вставить("ЭтоEnterpriseData", Ложь);
	КомпонентыОбмена.Вставить("БазовыеСхемыФормата", Новый Соответствие);
	
	// правила обмена
	КомпонентыОбмена.Вставить("МенеджерОбмена", Неопределено);
	КомпонентыОбмена.Вставить("ЭтоМенеджерОбменКФК", Ложь);
	КомпонентыОбмена.Вставить("ВерсияФорматаМенеджераОбмена", "");
	КомпонентыОбмена.Вставить("ОбъектыВыборкиФормата", Новый Структура);
	КомпонентыОбмена.Вставить("ОбъектыФормата", Новый Структура);
	
	// Параметры сообщения и дополнительные свойства сообщения.
	КомпонентыОбмена.Вставить("КлючСообщения", "");
	КомпонентыОбмена.Вставить("СвойстваСообщения", Новый Структура);
	КомпонентыОбмена.Вставить("ЗаголовкиСообщения", Новый Соответствие);
	
	// логирование
	КомпонентыОбмена.Вставить("ФлагОшибки", Ложь);
	КомпонентыОбмена.Вставить("ФлагПропустить", Ложь);
	КомпонентыОбмена.Вставить("ПротоколКонвертации", Новый Массив);
	
	ПользовательскиеНастройкиКонвертации(КомпонентыОбмена);
	
	//@skip-check constructor-function-return-section
	Возврат КомпонентыОбмена;
	
КонецФункции

// Инициализирует таблицы значений с правилами обмена и помещает их в КомпонентыОбмена.
//
// Параметры:
//  КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
//
Процедура ИнициализироватьТаблицыПравилОбмена(КомпонентыОбмена) Экспорт
	
	// Определение схемы формата обмена.
	КомпонентыОбмена.БазовыеСхемыФормата.Вставить(КомпонентыОбмена.XMLСхема, Истина);
	КомпонентыОбмена.БазовыеСхемыФормата.Вставить(XMLБазоваяСхема(), Истина);
	КомпонентыОбмена.ЭтоEnterpriseData = СтрНачинаетсяС(НРег(КомпонентыОбмена.XMLСхема),
		НРег("http://v8.1c.ru/edi/edi_stnd/EnterpriseData/"));
	
	// Определение версии формата обмена.
	ВерсияМенеджера = КомпонентыОбмена.МенеджерОбмена.ВерсияФорматаМенеджераОбмена(); // Строка
	КомпонентыОбмена.ВерсияФорматаМенеджераОбмена = СтрРазделить(ВерсияМенеджера, ".")[0];
	КомпонентыОбмена.ЭтоМенеджерОбменКФК = СтрЗаканчиваетсяНа(ВРег(ВерсияМенеджера), ".КФК");
	// Проверка поддержки версии формата обмена.
	Если КомпонентыОбмена.ВерсияФорматаМенеджераОбмена <> "2" Тогда
		ВызватьИсключение НСтр("ru = 'Неподдерживаемая версия формата обмена.'");
	КонецЕсли;
	
	// Инициализация таблиц правил обмена.
	КомпонентыОбмена.Вставить("ПравилаОбработкиДанных",     ТаблицаПравилОбработкиДанных(КомпонентыОбмена));
	КомпонентыОбмена.Вставить("ПравилаКонвертацииОбъектов", ТаблицаПравилКонвертации(КомпонентыОбмена));
	
	КомпонентыОбмена.Вставить("ПравилаКонвертацииПредопределенныхДанных",
		ТаблицаПравилКонвертацииПредопределенныхДанных(КомпонентыОбмена));
	
	КомпонентыОбмена.Вставить("ПараметрыКонвертации", СтруктураПараметровКонвертации(КомпонентыОбмена.МенеджерОбмена));
	
КонецПроцедуры

// Таблица правил обработки данных.
// 
// Параметры:
//	КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица правил обработки (ПОД):
// * Имя - Строка - 
// * ОбъектВыборкиФормат - Строка - 
// * ТипСсылкиXDTO - ТипЗначенияXDTO - 
// * ОбъектВыборкиМетаданные - ОбъектМетаданных - 
// * ВыборкаДанных - Строка - 
// * ИмяТаблицыДляВыборки - Строка - 
// * ПриОбработке - Строка - 
// * ИспользуемыеПКО - Массив из Строка - 
Функция ТаблицаПравилОбработкиДанных(КомпонентыОбмена) Экспорт
	
	XMLСхема = КомпонентыОбмена.XMLСхема;
	
	// Инициализация таблицы правил обработки данных.
	ПравилаОбработкиДанных = Новый ТаблицаЗначений;
	ПравилаОбработкиДанных.Колонки.Добавить("Имя");
	ПравилаОбработкиДанных.Колонки.Добавить("ОбъектВыборкиФормат");
	ПравилаОбработкиДанных.Колонки.Добавить("ТипСсылкиXDTO");
	ПравилаОбработкиДанных.Колонки.Добавить("ОбъектВыборкиМетаданные");
	ПравилаОбработкиДанных.Колонки.Добавить("ВыборкаДанных");
	ПравилаОбработкиДанных.Колонки.Добавить("ИмяТаблицыДляВыборки");
	ПравилаОбработкиДанных.Колонки.Добавить("ПриОбработке", Новый ОписаниеТипов("Строка"));
	
	// ИспользуемыеПКО - массив, содержащий имена ПКО, в которые может быть направлен объект из данного ПОД.
	ПравилаОбработкиДанных.Колонки.Добавить("ИспользуемыеПКО", Новый ОписаниеТипов("Массив"));
	
	КомпонентыОбмена.МенеджерОбмена.ЗаполнитьПравилаОбработкиДанных(
		КомпонентыОбмена.НаправлениеОбмена,
		ПравилаОбработкиДанных);
	
	КоличествоСтрок = ПравилаОбработкиДанных.Количество();
	Для НомерИтерации = 1 По КоличествоСтрок Цикл
		
		ИндексСтроки = КоличествоСтрок - НомерИтерации;
		ПОД = ПравилаОбработкиДанных.Получить(ИндексСтроки);
		Если Не ИнициализироватьПравилоОбработкиДанных(КомпонентыОбмена, XMLСхема, ПОД) Тогда
			ПравилаОбработкиДанных.Удалить(ПОД);
		КонецЕсли;
		
	КонецЦикла;
	
	Если КомпонентыОбмена.НаправлениеОбмена = "Отправка" Тогда
		ПравилаОбработкиДанных.Индексы.Добавить("Имя");
		ПравилаОбработкиДанных.Индексы.Добавить("ОбъектВыборкиМетаданные");
	Иначе
		ПравилаОбработкиДанных.Индексы.Добавить("ОбъектВыборкиФормат");
		ПравилаОбработкиДанных.Индексы.Добавить("ТипСсылкиXDTO");
	КонецЕсли;
	
	Возврат ПравилаОбработкиДанных;
	
КонецФункции

// Добавляет строку в таблицу правил конвертации и инициализирует значение в колонке "Свойства".
// Используется в модуле менеджера обмена при заполнении таблицы правил конвертации объектов.
//
// Параметры:
//  ПравилаКонвертации - см. КоллекцияПравилКонвертации
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - строка таблицы правил конвертации.
//
Функция ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации) Экспорт
	
	ПравилоКонвертации = ПравилаКонвертации.Добавить();
	ПравилоКонвертации.Свойства = ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
	Возврат ПравилоКонвертации;
	
КонецФункции

// Инициализирует таблицу значений для хранения правил конвертации свойств объекта.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица для хранения правил конвертации свойств:
//     * СвойствоКонфигурации - Строка
//     * СвойствоФормата - Строка
//     * ПравилоКонвертацииСвойства - Строка
//     * ИспользуетсяАлгоритмКонвертации - Булево
//     * ОбработкаКлючевогоСвойства - Булево
//     * ОбработкаПоисковогоСвойства - Булево
//     * ИмяТЧ - Строка
//
Функция ИнициализироватьТаблицуСвойствДляПравилаКонвертации() Экспорт
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока0 = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	ТипСтрокаИмяПравила = ОбщегоНазначения.ОписаниеТипаСтрока(100); // BSLLS:MagicNumber-off
	
	ТаблицаПКС = Новый ТаблицаЗначений;
	ТаблицаПКС.Колонки.Добавить("СвойствоКонфигурации", ТипСтрока0);
	ТаблицаПКС.Колонки.Добавить("СвойствоФормата", ТипСтрока0);
	
	ТаблицаПКС.Колонки.Добавить("ПравилоКонвертацииСвойства", ТипСтрокаИмяПравила);
	ТаблицаПКС.Колонки.Добавить("ИспользуетсяАлгоритмКонвертации", ТипБулево);
	
	ТаблицаПКС.Колонки.Добавить("ОбработкаКлючевогоСвойства",  ТипБулево);
	ТаблицаПКС.Колонки.Добавить("ОбработкаПоисковогоСвойства", ТипБулево);
	
	ТаблицаПКС.Колонки.Добавить("ИмяТЧ", ТипСтрока0);
	
	ТаблицаПКС.Колонки.Добавить("ПространствоИмен", ТипСтрока0);
	
	ТаблицаПКС.Индексы.Добавить("ПространствоИмен");
	ТаблицаПКС.Индексы.Добавить("СвойствоКонфигурации");

	Возврат ТаблицаПКС;
	
КонецФункции

// Заполняет колонку со свойствами табличных частей пустой таблицей значений с определенными колонками.
// Используется в текущем модуле, а также в модуле менеджера обмена при заполнении таблицы правил конвертации объектов.
//
// Параметры:
//  ПравилоКонвертации - СтрокаТаблицыЗначений - правило конвертации объектов.
//  ИмяКолонки - Строка - имя заполняемой колонки таблицы правил конвертации.
//
Процедура ИнициализироватьСвойстваТабличныхЧастей(ПравилоКонвертации, ИмяКолонки = "СвойстваТабличныхЧастей") Экспорт
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока0 = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	
	СвойстваТабличныхЧастей = Новый ТаблицаЗначений;
	СвойстваТабличныхЧастей.Колонки.Добавить("ТЧКонфигурации",          ТипСтрока0);
	СвойстваТабличныхЧастей.Колонки.Добавить("ТЧФормата",               ТипСтрока0);
	СвойстваТабличныхЧастей.Колонки.Добавить("Свойства",                Новый ОписаниеТипов("ТаблицаЗначений"));
	СвойстваТабличныхЧастей.Колонки.Добавить("ИспользуетсяАлгоритмКонвертации", ТипБулево);
	
	СвойстваТабличныхЧастей.Колонки.Добавить("ПространствоИмен",        ТипСтрока0);
	СвойстваТабличныхЧастей.Индексы.Добавить("ПространствоИмен");
	
	ПравилоКонвертации[ИмяКолонки] = СвойстваТабличныхЧастей;
	
КонецПроцедуры

#КонецОбласти

#Область ОбменДанными

// Формирует сообщение для отправки в очередь Kafka.
//
// Параметры:
//	КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
//	Источник - СправочникОбъект, ДокументОбъект, ЛюбаяСсылка, Структура - выгружаемые данные
//	ИмяПОД - Строка - Имя ПОД
//
// Возвращаемое значение:
//	Неопределено, Структура - Сообщение для отправки в очередь Kafka
Функция ПроизвестиВыгрузкуДанных(КомпонентыОбмена, Источник, ИмяПОД) Экспорт
	
	// Инициализация
	Результат = Неопределено;
	СброситьРезультатКонвертации(КомпонентыОбмена);
	
	Попытка
		
		// ПередКонвертацией
		ПередКонвертацией(КомпонентыОбмена, Источник);
		
		// Формирование сообщения	
		Результат = ВыгрузкаОбъектаВыборки(КомпонентыОбмена, Источник, ИмяПОД); // Неопределено, Структура
		
		// ПослеКонвертации
		ПослеКонвертации(КомпонентыОбмена, Источник, Результат);
		
	Исключение
		
		Результат = Неопределено;
		
		ОбработатьИсключениеКонвертации(КомпонентыОбмена, ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Если Результат = Неопределено И Не (КомпонентыОбмена.ФлагОшибки Или КомпонентыОбмена.ФлагПропустить) Тогда
		ЗаписатьВПротоколВыполнения(КомпонентыОбмена, НСтр("ru = 'Не удалось произвести конвертацию данных'"), Истина);
	КонецЕсли;
	
	// Результат
	Возврат Результат;
	
КонецФункции

// Произвести чтение данных.
// 
// Параметры:
//	КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
//	ТелоСообщения - Строка - Тело сообщения
//	ИмяПОД - Строка - Имя ПОД
//
// Возвращаемое значение:
//	Неопределено, ЛюбаяСсылка, РегистрСведенийКлючЗаписи - Результат загрузки данных
Функция ПроизвестиЧтениеДанных(КомпонентыОбмена, ТелоСообщения, ИмяПОД) Экспорт
	
	// Инициализация
	СброситьРезультатКонвертации(КомпонентыОбмена);
	
	Попытка
		
		// ПередКонвертацией
		ПередКонвертацией(КомпонентыОбмена, ТелоСообщения);
		
		// Формирование сообщения
		Результат = ПрочитатьСообщениеОбмена(
			КомпонентыОбмена, ТелоСообщения, ИмяПОД); // Неопределено, СправочникОбъект, ЛюбаяСсылка
		Если Результат <> Неопределено И КомпонентыОбмена.НавигационнаяСсылка Тогда
			ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ПолучитьНавигационнуюСсылку(Результат));
		КонецЕсли;
		
		// ПослеКонвертации
		ПослеКонвертации(КомпонентыОбмена, ТелоСообщения, Результат);
		
	Исключение
		
		ОбработатьИсключениеКонвертации(КомпонентыОбмена, ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

