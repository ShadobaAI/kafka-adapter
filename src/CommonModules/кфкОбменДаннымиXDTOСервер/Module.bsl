#Область ПоискПравилОбмена

// ПОД по имени.
// 
// Параметры:
//	КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
//	Имя - Строка - Имя ПОД
// 
// Возвращаемое значение:
//	Неопределено, Структура - Правило обработки данных:
Функция ПОДПоИмени(КомпонентыОбмена, Имя)
	
	Результат = КомпонентыОбмена.ПравилаОбработкиДанных.Найти(Имя, "Имя");
	Если Результат = Неопределено Тогда
		
		ОбъектВыборкиФормата = Неопределено;
		Если КомпонентыОбмена.НаправлениеОбмена = НаправлениеОбменаПолучение()
				И КомпонентыОбмена.ОбъектыВыборкиФормата.Свойство(Имя, ОбъектВыборкиФормата) Тогда
			ШаблонЗаголовка = НСтр("ru = 'В схеме формата обмена отсутствует XDTO!
			|ПОД: %1
			|Формата обмена: %2
			|Тип XDTO: %3'");
			ВызватьИсключение СтрШаблон(ШаблонЗаголовка, Имя, КомпонентыОбмена.XMLСхема, ОбъектВыборкиФормата);
			
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдено ПОД с именем %1'"), Имя);
			
		КонецЕсли;
		
	Иначе
		Возврат Результат;
		
	КонецЕсли;

КонецФункции

// ПКО по имени.
// 
// Параметры:
//	КомпонентыОбмена - см. ИнициализироватьКомпонентыОбмена
//	Имя - Строка - Имя ПКО
// 
// Возвращаемое значение:
//	Неопределено, СтрокаТаблицыЗначений - Правило конвертации объекта.
Функция ПКОПоИмени(КомпонентыОбмена, Имя)
	
	Результат = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти(Имя, "ИмяПКО");
	Если Результат = Неопределено Тогда
		
		ОбъектФормата = Неопределено;
		Если КомпонентыОбмена.ОбъектыФормата.Свойство(Имя, ОбъектФормата) Тогда
			ШаблонЗаголовка = НСтр("ru = 'В схеме формата обмена отсутствует XDTO!
			|ПКО: %1
			|Формата обмена: %2
			|Тип XDTO: %3'");
			ВызватьИсключение СтрШаблон(ШаблонЗаголовка, Имя, КомпонентыОбмена.XMLСхема, ОбъектФормата);
			
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдено ПКО с именем %1'"), Имя);
			
		КонецЕсли;
		
	Иначе
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

