#Область СлужебныйПрограммныйИнтерфейс

// Параметры регистрации.
// 
// Параметры:
//  Продюсеры - Неопределено, СправочникСсылка.кфкПродюсеры, Массив Из СправочникСсылка.кфкПродюсеры - Ссылка на продюсер
//  ПакетныйРежимЗаписи - Булево - Если Истина, то инициализируется "ОчередьИсходящих". По завершении необходимо вызвать ЗавершитьРегистрацию(Параметры)
// 
// Возвращаемое значение:
//  Структура - Параметры регистрации:
// * Продюсеры - Неопределено, Массив Из СправочникСсылка.кфкПродюсеры - Ссылка на продюсер 
// * ОчередьИсходящих - Неопределено, РегистрСведенийНаборЗаписей.кфкИсходящиеСообщения - Очередь исходящих, см. ЗавершитьРегистрацию
Функция ПараметрыРегистрации(Продюсеры = Неопределено, ПакетныйРежимЗаписи = Ложь) Экспорт

	Результат = Новый Структура;

	Если ТипЗнч(Продюсеры) = Тип("Массив") Тогда
		ПродюсерыРегистрации = Продюсеры;

	ИначеЕсли ЗначениеЗаполнено(Продюсеры) Тогда
		ПродюсерыРегистрации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Продюсеры);

	Иначе
		ПродюсерыРегистрации = Неопределено;
	КонецЕсли;
	Результат.Вставить("Продюсеры", ПродюсерыРегистрации);

	ОчередьИсходящих = ?(ПакетныйРежимЗаписи,
		кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкИсходящиеСообщения),
		Неопределено);
	Результат.Вставить("ОчередьИсходящих", ОчередьИсходящих);

	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Завершает пакетную регистрацию.
// 
// Параметры:
//  Параметры - Структура - Параметры регистрации, см. ПараметрыРегистрации:
//	 * Продюсеры - Неопределено, Массив Из СправочникСсылка.кфкПродюсеры - Ссылка на продюсер 
//	 * ОчередьИсходящих - Неопределено, РегистрСведенийНаборЗаписей.кфкИсходящиеСообщения - Очередь исходящих, см. ЗавершитьРегистрацию
//	ОчиститьОчередь - Булево - Очистить очередь исходящих
Процедура ЗавершитьРегистрацию(Параметры, ОчиститьОчередь = Ложь) Экспорт

	ОчередьИсходящих = Параметры.ОчередьИсходящих;
	Если Не ОчередьИсходящих = Неопределено И ОчередьИсходящих.Количество() > 0 Тогда

		// Если регистрация выполняется под обычным пользователем
		УстановитьПривилегированныйРежим(Истина); // BSLLS:SetPrivilegedMode-off

		ОчередьИсходящих.Записать(РежимЗамещения.Добавление);
		Если ОчиститьОчередь Тогда
			ОчередьИсходящих.Очистить();
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Возвращает максимально допустимый размер порции регистрации.
//
// Возвращаемое значение:
//   Число - максимальный размер порции регистрации
Функция МаксРазмерПорцииРегистрации() Экспорт
	Возврат 10000; // BSLLS:MagicNumber-off
КонецФункции

