// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Получить позицию.
// 
// Параметры:
//  Идентификатор - УникальныйИдентификатор - Идентификатор операции
//  Раздел - Строка - Дополнительный раздел операции
// 
// Возвращаемое значение:
//  Число - Полная комбинированная метка
Функция ПолучитьПозицию(Идентификатор, Раздел = "") Экспорт
	
	// Получаем сохранённую позицию операции и раздела.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Раздел", Раздел);
	Запрос.Текст = "ВЫБРАТЬ
	|    Т.КомбинированнаяМетка КАК КомбинированнаяМетка
	|ИЗ
	|    РегистрСведений.кфкПозицииОпераций КАК Т
	|ГДЕ
	|    Т.Идентификатор = &Идентификатор
	|    И Т.Раздел = &Раздел";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка[0], 0);
	
КонецФункции

// Обновить позиции.
// 
// Параметры:
//	Идентификатор - УникальныйИдентификатор - Идентификатор операции
//	КомбинированнаяМетка - Число - Полная комбинированная метка
//	Раздел - Неопределено - Дополнительный раздел операции не задан.
//	       - Структура:
//		* Значение - Строка - Идентификатор раздела
//		* Представление - Строка - Представление раздела
Процедура ОбновитьПозицию(Идентификатор, КомбинированнаяМетка, Раздел = Неопределено) Экспорт
	
	Набор = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(
		РегистрыСведений.кфкПозицииОпераций); // РегистрСведенийНаборЗаписей.кфкПозицииОпераций
	
	Набор.Отбор.Идентификатор.Установить(Идентификатор);
	Набор.Отбор.Раздел.Установить(?(Раздел = Неопределено, "", Раздел.Значение));
	
	НоваяСтрока = Набор.Добавить();
	НоваяСтрока.Идентификатор = Идентификатор;
	НоваяСтрока.КомбинированнаяМетка = КомбинированнаяМетка;
	
	Если Раздел <> Неопределено Тогда
		НоваяСтрока.Раздел = Раздел.Значение;
		НоваяСтрока.РазделПредставление = Раздел.Представление;
	КонецЕсли;
	
	Набор.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
