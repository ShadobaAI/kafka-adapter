  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.КомбинированнаяМетка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Т.Идентификатор КАК Идентификатор,
	Т.Идентификатор КАК Операция,
	Т.Раздел КАК Раздел,
	Т.КомбинированнаяМетка КАК КомбинированнаяМетка,
	ЦЕЛ(Т.КомбинированнаяМетка / &amp;ОснованиеВремениКомбинированнойМетки + &amp;МоментОтсчетаКомбинированнойМетки) КАК
		КомбинированнаяМеткаМС,
	ДОБАВИТЬКДАТЕ(&amp;ДатаОтсчетаКомбинированнойМетки, СЕКУНДА, ЦЕЛ(Т.КомбинированнаяМетка /
		&amp;ОснованиеВремениКомбинированнойМетки) / 1000) КАК КомбинированнаяМеткаДата,
	ВЫРАЗИТЬ(ЦЕЛ(Т.КомбинированнаяМетка / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30, 0)) -
		ВЫРАЗИТЬ(ЦЕЛ(ВЫРАЗИТЬ(ЦЕЛ(Т.КомбинированнаяМетка / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30, 0)) /
		&amp;ОснованиеСеансаКомбинированнойМетки) КАК ЧИСЛО(20, 0)) * &amp;ОснованиеСеансаКомбинированнойМетки КАК
		КомбинированнаяМеткаСеанс,
	Т.КомбинированнаяМетка - ВЫРАЗИТЬ(ЦЕЛ(Т.КомбинированнаяМетка / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30,
		0)) * &amp;ОснованиеСчетчикаКомбинированнойМетки КАК КомбинированнаяМеткаНомер,
	Т.РазделПредставление КАК РазделПредставление
ИЗ
	РегистрСведений.кфкПозицииОпераций КАК Т</queryText>
