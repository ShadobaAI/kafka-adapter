    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Т.КлючЗаписи КАК КлючЗаписи,
	Т.ХэшСумма КАК ХэшСумма,
	Т.ДатаОбновления КАК ДатаОбновления,
	Т.МеткаИзменения КАК МеткаИзменения,
	ЦЕЛ(Т.МеткаИзменения / &amp;ОснованиеВремениКомбинированнойМетки + &amp;МоментОтсчетаКомбинированнойМетки) КАК
		МеткаИзмененияМС,
	ДОБАВИТЬКДАТЕ(&amp;ДатаОтсчетаКомбинированнойМетки, СЕКУНДА, ЦЕЛ(Т.МеткаИзменения /
		&amp;ОснованиеВремениКомбинированнойМетки) / 1000) КАК МеткаИзмененияДата,
	ВЫРАЗИТЬ(ЦЕЛ(Т.МеткаИзменения / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30, 0)) -
		ВЫРАЗИТЬ(ЦЕЛ(ВЫРАЗИТЬ(ЦЕЛ(Т.МеткаИзменения / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30, 0)) / &amp;ОснованиеСеансаКомбинированнойМетки)
		КАК ЧИСЛО(20, 0)) * &amp;ОснованиеСеансаКомбинированнойМетки КАК МеткаИзмененияСеанс,
	Т.МеткаИзменения - ВЫРАЗИТЬ(ЦЕЛ(Т.МеткаИзменения / &amp;ОснованиеСчетчикаКомбинированнойМетки) КАК ЧИСЛО(30, 0)) *
		&amp;ОснованиеСчетчикаКомбинированнойМетки КАК МеткаИзмененияНомер
ИЗ
	РегистрСведений.кфкХэшСуммыСообщений КАК Т</queryText>
      <mainTable>InformationRegister.кфкХэшСуммыСообщений</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>КлючЗаписи</dataPath>
        <field>КлючЗаписи</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ХэшСумма</dataPath>
        <field>ХэшСумма</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ДатаОбновления</dataPath>
        <field>ДатаОбновления</field>
