#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Сбросить статус ошибки.
// 
// Параметры:
//  КлючиЗаписей - Массив Из РегистрСведенийКлючЗаписи.кфкВходящиеСообщения - Ключи записей
Процедура СброситьСтатусОшибки(КлючиЗаписей) Экспорт
	
	Очередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(
		РегистрыСведений.кфкВходящиеСообщения); // РегистрСведенийНаборЗаписей.кфкВходящиеСообщения
	
	//@skip-check invocation-parameter-type-intersect
	Таблица = Очередь.Выгрузить(, "КлючЗаписи,ДатаЗагрузкиМС");
	
	Для Каждого КлючЗаписей Из КлючиЗаписей Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), КлючЗаписей);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	//@skip-check ql-temp-table-index
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КлючЗаписи КАК КлючЗаписи,
	|	Т.ДатаЗагрузкиМС КАК ДатаЗагрузкиМС
	|ПОМЕСТИТЬ ВТКлючиЗаписей
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВходящиеСообщения.КлючЗаписи КАК КлючЗаписи,
	|	ВходящиеСообщения.ДатаЗагрузкиМС КАК ДатаЗагрузкиМС,
	|	ВЫБОР
	|		КОГДА ВходящиеСообщения.Статус = ЗНАЧЕНИЕ(Перечисление.кфкСтатусыСообщений.ОшибкаОбработки)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.кфкСтатусыСообщений.Новое)
	|	КОНЕЦ КАК Статус,
	|	ВходящиеСообщения.Заголовки КАК Заголовки,
	|	ВходящиеСообщения.ТелоСообщения КАК ТелоСообщения,
	|	ВходящиеСообщения.Консьюмер КАК Консьюмер,
	|	ВходящиеСообщения.Топик КАК Топик,
	|	ВходящиеСообщения.Раздел КАК Раздел,
	|	ВходящиеСообщения.Смещение КАК Смещение,
	|	ВходящиеСообщения.КлючСообщения КАК КлючСообщения,
	|	ВходящиеСообщения.ДатаЗаписи КАК ДатаЗаписи,
	|	ВходящиеСообщения.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ВходящиеСообщения.ДатаОбработки КАК ДатаОбработки,
	|	ВходящиеСообщения.ДлОбработкиМС КАК ДлОбработкиМС,
	|	ВходящиеСообщения.ТекстЖурнала КАК ТекстЖурнала,
	|	ВходящиеСообщения.КоличествоОбработок КАК КоличествоОбработок
	|ИЗ
	|	ВТКлючиЗаписей КАК ВТКлючиЗаписей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.кфкВходящиеСообщения КАК ВходящиеСообщения
	|		ПО ВТКлючиЗаписей.КлючЗаписи = ВходящиеСообщения.КлючЗаписи
	|		И ВТКлючиЗаписей.ДатаЗагрузкиМС = ВходящиеСообщения.ДатаЗагрузкиМС
	|ГДЕ
	|	ВходящиеСообщения.Статус = ЗНАЧЕНИЕ(Перечисление.кфкСтатусыСообщений.ОшибкаОбработки)";
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Очередь.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.МеткаИзмененияМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
	КонецЦикла;
	
	Очередь.Записать(РежимЗамещения.Обновление);
	
КонецПроцедуры

// Удалить сообщения.
// 
// Параметры:
//	КУдалению - Массив Из РегистрСведенийКлючЗаписи.кфкВходящиеСообщения - Список ключей записи
//			  - Структура - Описание запроса:
//					* Текст - Строка - Текст запроса
//					* Параметры - Структура - Параметры запроса
Процедура УдалитьСообщения(КУдалению) Экспорт

	Если ТипЗнч(КУдалению) = Тип("Массив") Тогда // Если передан массив
		УдалитьСообщенияПоКлючам(КУдалению);
	Иначе
		УдалитьСообщенияПоЗапросу(КУдалению);
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьРегистр() Экспорт
	кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкВходящиеСообщения).Записать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьСообщенияПоКлючам(КлючиЗаписей)

	// Создаем набор записей
	Набор = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкВходящиеСообщения);

	// Добавляем записи в набор
	Для Каждого КлючЗаписи Из КлючиЗаписей Цикл
		ЗаполнитьЗначенияСвойств(Набор.Добавить(), КлючЗаписи);
	КонецЦикла;

	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Удаляем записи из регистра
	Набор.Записать(РежимЗамещения.Удаление);

КонецПроцедуры

Процедура УдалитьСообщенияПоЗапросу(ОписаниеЗапроса)

	// Создаем набор записей
	Набор = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкВходящиеСообщения);

	// Создаем запрос
	Запрос = Новый Запрос;
	//@skip-check bsl-ql-hub
	Запрос.Текст = СтрЗаменить(ОписаниеЗапроса.Текст, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 10000");
	Для Каждого Параметр Из ОписаниеЗапроса.Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	// Повторный запрос намеренно ограничивает объем одной удаляемой порции десятью тысячами записей.
	// BSLLS:CreateQueryInCycle-off
	// Удаляем все записи из регистра по отбору
	Пока Истина Цикл

		// Выполняем запрос
		Выборка = Запрос.Выполнить().Выбрать();

		// Если записей нет, то завершаем цикл
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// Добавляем записи в набор
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Набор.Добавить(), Выборка);
		КонецЦикла;

		// Удаляем записи из регистра
		Набор.Записать(РежимЗамещения.Удаление);
	КонецЦикла;
	// BSLLS:CreateQueryInCycle-on

КонецПроцедуры

#КонецОбласти

#КонецЕсли
