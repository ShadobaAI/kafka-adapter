#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// инициализация нового
	Если Объект.Ссылка.Пустая() Тогда
		Ключи = ОбщегоНазначения.ВыгрузитьКолонку(Объект.ПараметрыКонсьюмера, "Ключ");
		Для Каждого Параметр Из СтандартныеПараметрыКонсьюмера() Цикл
			Если Ключи.Найти(Параметр.Ключ) = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Объект.ПараметрыКонсьюмера.Добавить(), Параметр);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	// инициализация оформление формы
	УстановитьУсловноеОформление();

	// инициализация параметров
	СвойстваLibrdKafka = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("C");
	ЗаполнитьЗначенияПредставления();

	// формат десериализации КД
	ПространстваИмен = Новый Массив(кфкИнтеграцияСлужебныйПовтИсп.ПространстваИменПакетовXDTO());
	Элементы.ФорматДесериализации.СписокВыбора.ЗагрузитьЗначения(ПространстваИмен);
	Элементы.ТопикиФорматДесериализации.СписокВыбора.ЗагрузитьЗначения(ПространстваИмен);

	// менеджер обмена КД
	ИменаОбщихМодулей = Новый Массив(кфкИнтеграцияСлужебныйПовтИсп.ИменаМенеджеровОбмена());
	Элементы.ИмяМодуляДесериализации.СписокВыбора.ЗагрузитьЗначения(ИменаОбщихМодулей);
	Элементы.ТопикиИмяМодуляДесериализации.СписокВыбора.ЗагрузитьЗначения(ИменаОбщихМодулей);

	// проверка доступности
	Для Каждого Элемент Из Элементы.ФормаГруппаЗапуска.ПодчиненныеЭлементы Цикл
		Элемент.Доступность = Не ТолькоПросмотр;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьЗначенияПредставления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьДоступность();
	
	УстановитьВидимостьСериализации();
	
	// доступные топики
	кфкИнтеграцияСлужебныйКлиент.ЗаполнитьСписокВыбораТопиков(ЭтотОбъект, Элементы.ТопикиТопик);
	
КонецПроцедуры

