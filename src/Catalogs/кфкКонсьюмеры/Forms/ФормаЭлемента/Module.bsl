&НаСервереБезКонтекста
Функция ДоступныеПОДы(Знач XMLСхема, Знач МенеджерОбмена)
	
	ФорматXDTO = кфкОбменДаннымиXDTOСервер.ПодобратьФорматXDTO(XMLСхема);
	Возврат кфкОбменДаннымиXDTOСервер.ИменаПравилОбработкиДанных(МенеджерОбмена, "Получение", ФорматXDTO);

КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияПредставления()
	
	Если СвойстваLibrdKafka = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.ПараметрыКонсьюмера Цикл // ТекущийОбъект
		
		Свойство = СвойстваLibrdKafka.Получить(Строка.Ключ); // см. кфкИнтеграцияСлужебный.НовоеОписаниеСвойстваLibrdKafka
		ТипЗначения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Свойство, "ТипЗначения");
		Строка.ЗначениеПредставление = ?(ТипЗначения = "int" Или ТипЗначения = "float",
			СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строка.Значение), Строка.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// Поле произвольного обработчика.
	Элемент = НовыйЭлементОформления();
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяМетодаДесериализации.Имя);
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	УстановитьОтборПоТипуОбработчика(ГруппаИсключение, Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);

	// Поля конвертации данных.
	Элемент = НовыйЭлементОформления();
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиФорматДесериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяМодуляДесериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяПОДДесериализации.Имя);
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	УстановитьОтборПоТипуОбработчика(ГруппаИсключение, Перечисления.кфкТипыОбработчиков.КонвертацияДанных);

	// Показываем значения по умолчанию в незаполненных полях строки.
	Если Не Объект.ТипДесериализации.Пустая() Тогда

		Элемент = НовыйЭлементОформления(Объект.ТипДесериализации);
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиТипДесериализации.Имя);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.Топики.ТипДесериализации", ,
			ВидСравненияКомпоновкиДанных.НеЗаполнено);

	КонецЕсли;

	Если Не ПустаяСтрока(Объект.ИмяМетодаДесериализации) Тогда

		Элемент = НовыйЭлементОформления(Объект.ИмяМетодаДесериализации);
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиИмяМетодаДесериализации.Имя);
		УстановитьОтборПоТипуОбработчика(Элемент.Отбор, Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект.Топики.ИмяМетодаДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);

	КонецЕсли;

	Если Не ПустаяСтрока(Объект.ИмяМодуляДесериализации) Тогда

		Элемент = НовыйЭлементОформления(Объект.ИмяМодуляДесериализации);
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиИмяМодуляДесериализации.Имя);
		УстановитьОтборПоТипуОбработчика(Элемент.Отбор, Перечисления.кфкТипыОбработчиков.КонвертацияДанных);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект.Топики.ИмяМодуляДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);

	КонецЕсли;

	Если Не ПустаяСтрока(Объект.ФорматДесериализации) Тогда

		Элемент = НовыйЭлементОформления(Объект.ФорматДесериализации);
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиФорматДесериализации.Имя);
		УстановитьОтборПоТипуОбработчика(Элемент.Отбор, Перечисления.кфкТипыОбработчиков.КонвертацияДанных);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект.Топики.ФорматДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);

	КонецЕсли;

КонецПроцедуры

// Добавляет оформление с нейтральным цветом для поля строки.
//
// Параметры:
//  ТекстПоУмолчанию - Строка, ПеречислениеСсылка.кфкТипыОбработчиков, Неопределено - значение для показа в поле.
//
// Возвращаемое значение:
//  ЭлементУсловногоОформленияКомпоновкиДанных - добавленный элемент оформления.
&НаСервере
Функция НовыйЭлементОформления(ТекстПоУмолчанию = Неопределено)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Если ТекстПоУмолчанию <> Неопределено Тогда
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", ТекстПоУмолчанию);
	КонецЕсли;

	Возврат Элемент;

КонецФункции

// Настраивает отбор по типу обработчика с учётом значения в шапке.
//
// Параметры:
//  Отбор - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - родитель создаваемой группы.
//  ТипОбработчика - ПеречислениеСсылка.кфкТипыОбработчиков - тип, для которого применяется оформление.
&НаСервереБезКонтекста
Процедура УстановитьОтборПоТипуОбработчика(Отбор, ТипОбработчика)

	// Если тип в строке не указан, действует тип из шапки.
	ПутьКТипуВСтроке = "Объект.Топики.ТипДесериализации";
	Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Отбор, "Условие",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, ПутьКТипуВСтроке, ТипОбработчика);
	ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
		ПутьКТипуВСтроке, , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипДесериализации",
		ТипОбработчика);

КонецПроцедуры

#КонецОбласти
