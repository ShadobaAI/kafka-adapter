#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьЧтение(Команда)
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Консьюмер был изменен. Для начала чтения сообщений сохраните настройки.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗапускДоступен() Тогда
		//@skip-check new-font
		кфкИнтеграцияСлужебныйКлиент.СообщениеНедоступностиРучногоЗадания();
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗапуститьЧтениеНаСервере(Объект.Ссылка, УникальныйИдентификатор);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ЗавершитьПоток", ЭтотОбъект),
		ПараметрыОжидания);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьДесериализацию(Команда)
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Консьюмер был изменен. Для начала десериализации сообщений сохраните настройки.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗапускДоступен() Тогда
		//@skip-check new-font
		кфкИнтеграцияСлужебныйКлиент.СообщениеНедоступностиРучногоЗадания();
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗапуститьДесериализациюНаСервере(Объект.Ссылка, УникальныйИдентификатор);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ЗавершитьПоток", ЭтотОбъект),
		ПараметрыОжидания);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтандартныеПараметрыКонсьюмера(Команда)
	
	Объект.ПараметрыКонсьюмера.Очистить();
	
	Для Каждого Параметр Из СтандартныеПараметрыКонсьюмера() Цикл
		НоваяСтрока = Объект.ПараметрыКонсьюмера.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметр);
		НоваяСтрока.ЗначениеПредставление = Параметр.Значение;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#Область Блокировка

&НаКлиенте
Процедура БлокироватьЧтение(Команда)
	
	Модифицированность = Истина;
	
	Объект.БлокироватьЧтение = Не Объект.БлокироватьЧтение;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура БлокироватьДесериализацию(Команда)
	
	Модифицированность = Истина;
	
	Объект.БлокироватьДесериализацию = Не Объект.БлокироватьДесериализацию;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	Элементы.ФормаГруппаБлокировка.Доступность = Не Объект.Ссылка.Пустая();
	Элементы.ФормаБлокироватьЧтение.Пометка = Объект.БлокироватьЧтение;
	Элементы.ФормаБлокироватьДесериализацию.Пометка = Объект.БлокироватьДесериализацию;
	
	Элементы.ГруппаДекорацияБлокироватьЧтение.Видимость = Объект.БлокироватьЧтение;
	Элементы.ГруппаДекорацияБлокироватьДесериализацию.Видимость = Объект.БлокироватьДесериализацию;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСериализации()

	// НастройкиПоУмолчанию
	ТипДесериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.ПустаяСсылка");
	Строки = Объект.Топики.НайтиСтроки(Новый Структура("ТипДесериализации", ТипДесериализации));
	ИспользуетсяНастройкаПоУмолчанию = Объект.Топики.Количество() = 0 Или Строки.Количество() > 0;

	// ПроизвольныйОбработчик
	ТипДесериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.ПроизвольныйОбработчик");
	Строки = Объект.Топики.НайтиСтроки(Новый Структура("ТипДесериализации", ТипДесериализации));
	Элементы.ТопикиИмяМетодаДесериализации.Видимость = Строки.Количество() > 0
		Или ИспользуетсяНастройкаПоУмолчанию И ТипДесериализации = Объект.ТипДесериализации;

	// КонвертацияДанных
	ТипДесериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.КонвертацияДанных");
	Строки = Объект.Топики.НайтиСтроки(Новый Структура("ТипДесериализации", ТипДесериализации));
	Элементы.ТопикиГруппаДесериализацияКД.Видимость = Строки.Количество() > 0
		Или ИспользуетсяНастройкаПоУмолчанию И ТипДесериализации = Объект.ТипДесериализации;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПоток(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		Если Результат.Свойство("ИнформацияОбОшибке") И Результат.ИнформацияОбОшибке <> Неопределено Тогда
			СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
			
		ИначеЕсли Не ПустаяСтрока(Результат.ПодробноеПредставлениеОшибки) Тогда // TODO: ИнформацияОбОшибке с БСП 3.1.10
			ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
			
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Возникла ошибка при завершении потока.'"));
		КонецЕсли;
		
		Возврат;
		 
	КонецЕсли;
	
КонецПроцедуры

// Принимает имя процедуры из формы ввода обработчика.
//
// Параметры:
//  РезультатЗакрытия - Строка, Неопределено - имя процедуры или отмена выбора.
//  ЭтоПоУмолчанию - Булево - изменять общий метод вместо метода текущего топика.
&НаКлиенте
Процедура ЗавершитьВводаОбработчика(РезультатЗакрытия, ЭтоПоУмолчанию) Экспорт

	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоПоУмолчанию Тогда
		Объект.ИмяМетодаДесериализации = РезультатЗакрытия;

	Иначе
		ТекущиеДанные = Элементы.Топики.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ТекущиеДанные.ИмяМетодаДесериализации = РезультатЗакрытия;

	КонецЕсли;

	Модифицированность = Истина;

	УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьПравилаОбмена()

	ОчиститьСообщения();

	СписокВыбора = Элементы.ТопикиИмяПОДДесериализации.СписокВыбора;
	СписокВыбора.Очистить();

	ТекущиеДанные = Элементы.Топики.ТекущиеДанные;
	ИмяМодуляДесериализации = ?(ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ИмяМодуляДесериализации),
		Объект.ИмяМодуляДесериализации, ТекущиеДанные.ИмяМодуляДесериализации);
	ФорматДесериализации = ?(ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ФорматДесериализации),
		Объект.ФорматДесериализации, ТекущиеДанные.ФорматДесериализации);
	Если ПустаяСтрока(ИмяМодуляДесериализации) Или ПустаяСтрока(ФорматДесериализации) Тогда
		Возврат;
	КонецЕсли;

	КлючПравилОбмена = ИмяМодуляДесериализации + ":" + ФорматДесериализации;

	ПОДы = ?(ПравилаОбработкиДанных = Неопределено, Неопределено,
		ПравилаОбработкиДанных.Получить(КлючПравилОбмена)); // Неопределено, Массив из Строка, Строка
	Если ПОДы = Неопределено Тогда

		ПОДы = ДоступныеПОДы(
			ФорматДесериализации,
			ИмяМодуляДесериализации); // Массив из Строка, Строка

		Правила = ?(ПравилаОбработкиДанных = Неопределено,
			Новый Соответствие, Новый Соответствие(ПравилаОбработкиДанных));
		Правила.Вставить(КлючПравилОбмена, ПОДы);
		ПравилаОбработкиДанных = Новый ФиксированноеСоответствие(Правила);

	КонецЕсли;

	Если ТипЗнч(ПОДы) = Тип("Массив") Тогда
		СписокВыбора.ЗагрузитьЗначения(ПОДы);
		Возврат;
	КонецЕсли;

	ТипДесериализации = ?(ТекущиеДанные = Неопределено Или ТекущиеДанные.ТипДесериализации.Пустая(),
		Объект.ТипДесериализации, ТекущиеДанные.ТипДесериализации);
	Если ТекущиеДанные <> Неопределено
			И ТипДесериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.КонвертацияДанных") Тогда
		//@skip-check bsl-legacy-check-dynamic-feature-access
		НомерСтроки = ТекущиеДанные.НомерСтроки;
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Имя модуля'"), НомерСтроки, НСтр("ru = 'Топики'"),
			СтрШаблон(НСтр("ru = '''%1'' - не найден'"), ИмяМодуляДесериализации));
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Топики", НомерСтроки,
			"ИмяМодуляДесериализации");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , Поле, "Объект");
	КонецЕсли;

КонецПроцедуры

