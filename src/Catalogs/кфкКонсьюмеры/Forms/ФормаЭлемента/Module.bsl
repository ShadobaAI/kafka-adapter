&НаСервере
Процедура ЗаполнитьЗначенияПредставления()
	
	Если СвойстваLibrdKafka = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.ПараметрыКонсьюмера Цикл // ТекущийОбъект
		
		Свойство = СвойстваLibrdKafka.Получить(Строка.Ключ); // см. кфкИнтеграцияСлужебный.НовоеОписаниеСвойстваLibrdKafka
		ТипЗначения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Свойство, "ТипЗначения");
		Строка.ЗначениеПредставление = ?(ТипЗначения = "int" Или ТипЗначения = "float",
			СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строка.Значение), Строка.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// ПроизвольныйОбработчик
	Элемент = УсловноеОформление.Элементы.Добавить();
	//	* Оформление
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	//	* Поля
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяМетодаДесериализации.Имя);
	//	* Отбор/Группа
	// НЕ ПроизвольныйОбработчик:
	//		НЕ (
	//			Строка.ТипДесериализации=ПроизвольныйОбработчик
	//			ИЛИ (Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=ПроизвольныйОбработчик)
	//		)
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаИсключение, "Условие",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	//	* Отбор/Элементы: Строка.ТипДесериализации=ПроизвольныйОбработчик
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, "Объект.Топики.ТипДесериализации",
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	//	* Отбор/Элементы: Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=ПроизвольныйОбработчик
	ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
		"Объект.Топики.ТипДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипДесериализации",
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);

	// КонвертацияДанных
	Элемент = УсловноеОформление.Элементы.Добавить();
	//	* Оформление
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	//	* Поля
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиФорматДесериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяМодуляДесериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ТопикиИмяПОДДесериализации.Имя);
	//	* Отбор/Группа
	// НЕ КонвертацияДанных:
	//		НЕ (
	//			Строка.ТипДесериализации=КонвертацияДанных
	//			ИЛИ (Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=КонвертацияДанных)
	//		)
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаИсключение, "Условие",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	//	* Отбор/Элементы: Строка.ТипДесериализации=КонвертацияДанных
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, "Объект.Топики.ТипДесериализации",
		Перечисления.кфкТипыОбработчиков.КонвертацияДанных);
	//	* Отбор/Элементы: Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=КонвертацияДанных
	ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
		"Объект.Топики.ТипДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипДесериализации",
		Перечисления.кфкТипыОбработчиков.КонвертацияДанных);

	// НастройкиПоУмолчанию
	//  * ТипДесериализации
	Если Не Объект.ТипДесериализации.Пустая() Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		//	* Оформление
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
		Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Объект.ТипДесериализации);
		//	* Поля
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиТипДесериализации.Имя);
		//	* Отбор
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.Топики.ТипДесериализации", ,
			ВидСравненияКомпоновкиДанных.НеЗаполнено);
	КонецЕсли;
	//  * ИмяМетодаДесериализации
	Если Не ПустаяСтрока(Объект.ИмяМетодаДесериализации) Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		//	* Оформление
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
		Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Объект.ИмяМетодаДесериализации);
		//	* Поля
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ТопикиИмяМетодаДесериализации.Имя);
		//	* Отбор/ПроизвольныйОбработчик
		// ПроизвольныйОбработчик:
		//		Строка.ТипДесериализации=ПроизвольныйОбработчик
		//		ИЛИ (Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=ПроизвольныйОбработчик)
		Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Условие",
			ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		//	* Отбор/ПроизвольныйОбработчик: Строка.ТипДесериализации=ПроизвольныйОбработчик
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, "Объект.Топики.ТипДесериализации",
			Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
		//	* Отбор/ПроизвольныйОбработчик: Строка.ТипДесериализации=ПустаяСсылка И ТипДесериализации=ПроизвольныйОбработчик
		ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
			ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
			"Объект.Топики.ТипДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипДесериализации",
			Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
		//	* Отбор/ИмяМетодаДесериализации
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект.Топики.ИмяМетодаДесериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	КонецЕсли;
	//  * ИмяМодуляДесериализации
	Если Не ПустаяСтрока(Объект.ИмяМодуляДесериализации) Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		//	* Оформление
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
