&НаКлиенте
Процедура БлокироватьПубликацию(Команда)
	
	Модифицированность = Истина;
	
	Объект.БлокироватьПубликацию = Не Объект.БлокироватьПубликацию;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	Элементы.ФормаГруппаБлокировка.Доступность = Не Объект.Ссылка.Пустая();
	Элементы.ФормаБлокироватьРегистрацию.Пометка = Объект.БлокироватьРегистрацию;
	Элементы.ФормаБлокироватьСериализацию.Пометка = Объект.БлокироватьСериализацию;
	Элементы.ФормаБлокироватьПубликацию.Пометка = Объект.БлокироватьПубликацию;
	
	Элементы.ГруппаДекорацияБлокироватьРегистрацию.Видимость = Объект.БлокироватьРегистрацию;
	Элементы.ГруппаДекорацияБлокироватьСериализацию.Видимость = Объект.БлокироватьСериализацию;
	Элементы.ГруппаДекорацияБлокироватьПубликацию.Видимость = Объект.БлокироватьПубликацию;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСериализации()
	
	// НастройкиПоУмолчанию
	ТипСериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.ПустаяСсылка");
	Строки = Объект.ОбъектыМетаданных.НайтиСтроки(Новый Структура("ТипСериализации", ТипСериализации));
	ИспользуетсяНастройкаПоУмолчанию = Объект.ОбъектыМетаданных.Количество() = 0 Или Строки.Количество() > 0;
	
	// ПроизвольныйОбработчик
	ТипСериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.ПроизвольныйОбработчик");
	Строки = Объект.ОбъектыМетаданных.НайтиСтроки(Новый Структура("ТипСериализации", ТипСериализации));
	Элементы.ОбъектыМетаданныхИмяМетодаСериализации.Видимость = Строки.Количество() > 0
		Или ИспользуетсяНастройкаПоУмолчанию И ТипСериализации = Объект.ТипСериализации;
	
	// КонвертацияДанных
	ТипСериализации = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.КонвертацияДанных");
	Строки = Объект.ОбъектыМетаданных.НайтиСтроки(Новый Структура("ТипСериализации", ТипСериализации));
	Элементы.ОбъектыМетаданныхГруппаСериализацияКД.Видимость = Строки.Количество() > 0
		Или ИспользуетсяНастройкаПоУмолчанию И ТипСериализации = Объект.ТипСериализации;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПоток(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		Если Результат.Свойство("ИнформацияОбОшибке") И Результат.ИнформацияОбОшибке <> Неопределено Тогда
			СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
			
		ИначеЕсли Не ПустаяСтрока(Результат.ПодробноеПредставлениеОшибки) Тогда // TODO: ИнформацияОбОшибке с БСП 3.1.10
			ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
			
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Возникла ошибка при завершении потока.'"));
		КонецЕсли;
		
		Возврат;
		 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыбораОбъектаМетаданных(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	
	Строки = Объект.ОбъектыМетаданных.НайтиСтроки(Новый Структура("ТипОбъект", РезультатЗакрытия));
	Для Каждого Строка Из Строки Цикл
		//@skip-check bsl-legacy-check-dynamic-feature-access
		Если ТекущиеДанные.НомерСтроки <> Строка.НомерСтроки Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеДанные.ТипОбъект = РезультатЗакрытия;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводаОбработчика(РезультатЗакрытия, ЭтоПоУмолчанию) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоПоУмолчанию Тогда
		Объект.ИмяМетодаСериализации = РезультатЗакрытия;
		
	Иначе
		ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
		ТекущиеДанные.ИмяМетодаСериализации = РезультатЗакрытия;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Функция КлючиПараметровПродюсера()
	
	Результат = Новый Массив;
	Для Каждого ПараметрОтправки Из Объект.ПараметрыПродюсера Цикл
		Результат.Добавить(ПараметрОтправки.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьПравилаОбмена()
	
	ОчиститьСообщения();
	
	СписокВыбора = Элементы.ОбъектыМетаданныхИмяПОДСериализации.СписокВыбора;
	СписокВыбора.Очистить();
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	
	ИмяМодуляСериализации = ?(ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ИмяМодуляСериализации),
		Объект.ИмяМодуляСериализации, ТекущиеДанные.ИмяМодуляСериализации);
	Если ПустаяСтрока(ИмяМодуляСериализации) Тогда
		Возврат;
	КонецЕсли;
	
	КлючПравилОбмена = ИмяМодуляСериализации;
	ПОДы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПравилаОбработкиДанных, КлючПравилОбмена); // Неопределено, Массив
	Если ПОДы = Неопределено Тогда
		
		ПОДы = ДоступныеПОДы(ИмяМодуляСериализации); // Неопределено, Массив
		
		Правила = ?(ПравилаОбработкиДанных = Неопределено, Новый Структура, Новый Структура(ПравилаОбработкиДанных));
		Правила.Вставить(КлючПравилОбмена, ПОДы);
		ПравилаОбработкиДанных = Новый ФиксированнаяСтруктура(Правила);
		
	КонецЕсли;
	Если ТипЗнч(ПОДы) = Тип("Массив") Тогда
		СписокВыбора.ЗагрузитьЗначения(ПОДы);
		Возврат;
	КонецЕсли;
	
	ТипСериализации = ?(ТекущиеДанные = Неопределено Или ТекущиеДанные.ТипСериализации.Пустая(),
		Объект.ТипСериализации, ТекущиеДанные.ТипСериализации);
	Если ТекущиеДанные <> Неопределено
			И ТипСериализации  = ПредопределенноеЗначение("Перечисление.кфкТипыОбработчиков.КонвертацияДанных") Тогда
		//@skip-check bsl-legacy-check-dynamic-feature-access
		НомерСтроки = ТекущиеДанные.НомерСтроки;
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Имя модуля'"), НомерСтроки, НСтр("ru = 'Объекты метаданных'"),
			СтрШаблон(НСтр("ru = '''%1'' - не найден'"), ИмяМодуляСериализации));
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ОбъектыМетаданных", НомерСтроки,
			"ИмяМодуляСериализации");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , Поле, "Объект");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтандартныеПараметрыКонсьюмера()
	
//	см. Обработка.кфкИнтеграция.ОтправитьСообщение()
	
	Результат = Новый Соответствие;
	Результат.Вставить("message.timeout.ms", 5000); // с этим параметром поакуратнее	
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗапускДоступен()
	Возврат Не ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции");
КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьСериализациюНаСервере(Знач Продюсер, Знач Идентификатор)
	Возврат кфкФоновыеОперацииСлужебный.ЗапуститьПотокИнтерактивно(Продюсер, Истина, Идентификатор);
КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьПубликациюНаСервере(Знач Продюсер, Знач Идентификатор)
	Возврат кфкФоновыеОперацииСлужебный.ЗапуститьПотокИнтерактивно(Продюсер, Ложь, Идентификатор);
КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеПОДы(Знач МенеджерОбмена)
	
	Если Метаданные.ОбщиеМодули.Найти(МенеджерОбмена) = Неопределено Тогда
		Возврат МенеджерОбмена;
	КонецЕсли;
	
	КомпонентыОбмена = кфкОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена("Отправка");
	КомпонентыОбмена.МенеджерОбмена = ОбщегоНазначения.ОбщийМодуль(МенеджерОбмена);
	ПОДы = кфкОбменДаннымиXDTOСервер.ТаблицаПравилОбработкиДанных(КомпонентыОбмена);
	
	Возврат ОбщегоНазначения.ВыгрузитьКолонку(ПОДы, "Имя");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияПредставления()
	
	Если СвойстваLibrdKafka = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.ПараметрыПродюсера Цикл // ТекущийОбъект
		
		Свойство = СвойстваLibrdKafka.Получить(Строка.Ключ); // см. кфкИнтеграцияСлужебный.НовоеОписаниеСвойстваLibrdKafka
		ТипЗначения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Свойство, "ТипЗначения");
		Строка.ЗначениеПредставление = ?(ТипЗначения = "int" Или ТипЗначения = "float",
			СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строка.Значение), Строка.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// ПроизвольныйОбработчик
	Элемент = УсловноеОформление.Элементы.Добавить();
	//	* Оформление
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	//	* Поля
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ОбъектыМетаданныхИмяМетодаСериализации.Имя);
	//	* Отбор/Группа
	// НЕ ПроизвольныйОбработчик:
	//		НЕ (
	//			Строка.ТипСериализации=ПроизвольныйОбработчик
	//			ИЛИ (Строка.ТипСериализации=ПустаяСсылка И ТипСериализации=ПроизвольныйОбработчик)
	//		)
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаИсключение, "Условие",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	//	* Отбор/Элементы: Строка.ТипСериализации=ПроизвольныйОбработчик
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, "Объект.ОбъектыМетаданных.ТипСериализации",
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	//	* Отбор/Элементы: Строка.ТипСериализации=ПустаяСсылка И ТипСериализации=ПроизвольныйОбработчик
	ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
		"Объект.ОбъектыМетаданных.ТипСериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипСериализации",
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	
	// КонвертацияДанных
	Элемент = УсловноеОформление.Элементы.Добавить();
	//	* Оформление
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	//	* Поля
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ОбъектыМетаданныхФорматСериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ОбъектыМетаданныхИмяМодуляСериализации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
		Элементы.ОбъектыМетаданныхИмяПОДСериализации.Имя);
	//	* Отбор/Группа
	// НЕ КонвертацияДанных:
	//		НЕ (
	//			Строка.ТипСериализации=КонвертацияДанных
	//			ИЛИ (Строка.ТипСериализации=ПустаяСсылка И ТипСериализации=КонвертацияДанных)
	//		)
	ГруппаИсключение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор, "Исключение",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе);
	Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаИсключение, "Условие",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	//	* Отбор/Элементы: Строка.ТипСериализации=КонвертацияДанных
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Группа, "Объект.ОбъектыМетаданных.ТипСериализации",
		Перечисления.кфкТипыОбработчиков.КонвертацияДанных);
	//	* Отбор/Элементы: Строка.ТипСериализации=ПустаяСсылка И ТипСериализации=КонвертацияДанных
	ГруппаПоУмолчанию = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Группа, "ПоУмолчанию",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию,
		"Объект.ОбъектыМетаданных.ТипСериализации", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаПоУмолчанию, "Объект.ТипСериализации",
		Перечисления.кфкТипыОбработчиков.КонвертацияДанных);
	
	// НастройкиПоУмолчанию
	//  * ТипСериализации
	Если Не Объект.ТипСериализации.Пустая() Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		//	* Оформление
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
		Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Объект.ТипСериализации);
		//	* Поля
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(
			Элементы.ОбъектыМетаданныхТипСериализации.Имя);
		//	* Отбор
